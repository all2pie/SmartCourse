APP_ENV=development

# Shared Postgres server (docker compose + migrations)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Shared MongoDB server (docker compose + migrations)
MONGO_PORT=27017

# Gateway (the only public entrypoint)
GATEWAY_PORT=8000
GATEWAY_IDENTITY_URL=http://localhost:8081
GATEWAY_CATALOG_URL=http://localhost:8082

# Identity service
IDENTITY_PORT=8081
IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=5432
IDENTITY_DB_USER=postgres
IDENTITY_DB_PASSWORD=
IDENTITY_DB_NAME=identity

# Catalog service (directConnection skips replica-set host discovery)
CATALOG_PORT=8082
CATALOG_MONGO_URI=mongodb://localhost:27017/?directConnection=true
CATALOG_MONGO_NAME=catalog